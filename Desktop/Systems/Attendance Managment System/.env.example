# Copy to .env and adjust. Every value is optional.
PORT=3000
# Work schedule in the server's local time. Check-in after WORK_START is "late"; check-out before
# WORK_END (WORK_END_SAT on Saturdays) is flagged "early". 08:45 = 2:45 Ethiopian, 17:30 = 11:30, 16:30 = 10:30. WORK_DAYS: 0=Sunday ... 6=Saturday (default Monday-Saturday).
WORK_START=08:45
WORK_END=17:30
WORK_END_SAT=16:30
WORK_DAYS=1,2,3,4,5,6
# If unset, a random secret is generated once and stored in data/jwt.secret.
# JWT_SECRET=
JWT_EXPIRES_IN=8h
# Bootstrap admin account, created only when no admin exists yet.
# If ADMIN_PASSWORD is unset, a random one is printed to the console on first run.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# DB_PATH=data/attendance.db

# Automatic database snapshots (VACUUM INTO). 0 disables them.
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14
# BACKUP_DIR=backups

# Extra origins allowed to call the API (default: VS Code Live Server).
# CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Number of reverse proxies in front of the app (1 behind Caddy/nginx). Leave unset when exposed directly.
# TRUST_PROXY=1

# Docker only: public domain for the https profile, and timezone for the "late" cutoff.
# DOMAIN=attendance.example.com
# TZ=Africa/Addis_Ababa
