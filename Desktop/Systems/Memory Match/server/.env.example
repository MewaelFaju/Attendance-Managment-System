PORT=4000
# Leave MONGO_URI empty to use a throw-away in-memory MongoDB (dev only, data is lost on restart)
MONGO_URI=
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
# First registered user with this email becomes admin
ADMIN_EMAIL=admin@playverse.local
ADMIN_PASSWORD=Admin123!
